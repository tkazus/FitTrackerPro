<Window x:Class="FitTrackerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitTracker Pro"
        Width="1300"
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2D2D30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FitTracker Pro" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="UserInfoText" Foreground="#888888" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="LogoutButton" 
                            Content="Выйти" 
                            Height="28" 
                            Width="60" 
                            Background="#E81123" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontWeight="Bold" 
                            FontSize="12" 
                            Click="LogoutButton_Click" 
                            Cursor="Hand"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="MinimizeButton" Content="─" Width="28" Height="28" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click" Cursor="Hand"/>
                    <Button x:Name="MaximizeButton" Content="☐" Width="28" Height="28" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" FontSize="12" Click="MaximizeButton_Click" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" FontSize="12" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка -->
            <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Упражнения" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox x:Name="SearchTextBox" 
                             Height="32" 
                             Margin="0,0,0,10" 
                             Background="#1E1E1E" 
                             Foreground="#D0D0D0" 
                             BorderBrush="#3E3E42" 
                             BorderThickness="1" 
                             FontSize="13" 
                             Padding="8,5,8,5"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_Changed"/>
                    <ListBox x:Name="ExercisesListBox" 
                             DisplayMemberPath="Name" 
                             Height="570" 
                             FontSize="13" 
                             Background="#1E1E1E" 
                             Foreground="#D0D0D0" 
                             BorderBrush="#3E3E42" 
                             BorderThickness="1" 
                             SelectionChanged="ExercisesListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Центральная колонка -->
            <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="15" Margin="4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Информация" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Название" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="NameText" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Описание" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DescriptionText" Foreground="#D0D0D0" TextWrapping="Wrap" FontSize="13" LineHeight="1.5"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Техника выполнения" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TechniqueText" Foreground="#D0D0D0" TextWrapping="Wrap" FontSize="13" LineHeight="1.5"/>
                            </StackPanel>
                        </Border>

                        <!-- Видео -->
                        <!-- Видео -->
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Видео" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1" Background="#0D0D0D" Height="180">
                                    <MediaElement x:Name="ExerciseVideo" 
                          LoadedBehavior="Manual" 
                          UnloadedBehavior="Manual" 
                          Stretch="Uniform"
                          MediaEnded="ExerciseVideo_MediaEnded"/>
                                </Border>

                                <!-- Кнопки управления видео -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                    x:Name="PlayButton" 
                    Content="ыВоспроизвести" 
                    Height="32" 
                    Margin="0,0,5,0" 
                    Background="#4CAF50" 
                    Foreground="White" 
                    BorderThickness="0" 
                    FontWeight="Bold" 
                    FontSize="13" 
                    Click="PlayButton_Click" 
                    Cursor="Hand"/>

                                    <Button Grid.Column="1" 
                    x:Name="StopVideoButton" 
                    Content="Остановить" 
                    Height="32" 
                    Margin="5,0,0,0" 
                    Background="#E81123" 
                    Foreground="White" 
                    BorderThickness="0" 
                    FontWeight="Bold" 
                    FontSize="13" 
                    Click="StopVideoButton_Click" 
                    Cursor="Hand"/>
                                </Grid>

                                <!-- Статус видео -->
                                <TextBlock x:Name="VideoStatusText" 
                   Foreground="#888888" 
                   FontSize="11" 
                   Margin="0,5,0,0" 
                   HorizontalAlignment="Center"
                   Text="Выберите упражнение для просмотра видео"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая колонка -->
            <Border Grid.Column="2" Background="#2D2D30" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Тренировка" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Button x:Name="StartWorkoutButton" Content="Начать тренировку" Height="36" Margin="0,0,0,6" Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Click="StartWorkoutButton_Click" Cursor="Hand"/>
                        <Button x:Name="FinishWorkoutButton" Content="Завершить тренировку" Height="36" Margin="0,0,0,12" Background="#E81123" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Click="FinishWorkoutButton_Click" Visibility="Collapsed" Cursor="Hand"/>

                        <Border Background="#1E1E1E" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Вес (кг)" Foreground="#888888" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WeightTextBox" Height="30" Margin="0,0,0,6" Background="#1E1E1E" Foreground="#D0D0D0" BorderBrush="#3E3E42" BorderThickness="1" FontSize="13" Padding="8,4,8,4" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Подходы" Foreground="#888888" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SetsTextBox" Height="30" Margin="0,0,0,6" Background="#1E1E1E" Foreground="#D0D0D0" BorderBrush="#3E3E42" BorderThickness="1" FontSize="13" Padding="8,4,8,4" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Повторы" Foreground="#888888" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="RepsTextBox" Height="30" Background="#1E1E1E" Foreground="#D0D0D0" BorderBrush="#3E3E42" BorderThickness="1" FontSize="13" Padding="8,4,8,4" VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button x:Name="AddExerciseButton" Content="Добавить упражнение" Height="34" Margin="0,0,0,6" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Click="AddExerciseButton_Click" IsEnabled="False" Cursor="Hand"/>
                        <Button x:Name="DeleteExerciseButton" Content="Удалить упражнение" Height="34" Margin="0,0,0,12" Background="#E81123" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Click="DeleteExerciseButton_Click" IsEnabled="False" Cursor="Hand"/>

                        <TextBlock Text="Текущая тренировка" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <DataGrid x:Name="WorkoutDataGrid" Height="200" Margin="0,0,0,0" Background="#1E1E1E" Foreground="#D0D0D0" BorderBrush="#3E3E42" AutoGenerateColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" FontSize="12">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="#3E3E42"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#1E1E1E"/>
                                    <Setter Property="Foreground" Value="#D0D0D0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>